---
import Base from '../layouts/Base.astro';
import { TOP5 } from '../data/healthy.js';
import { VIDEOS } from '../data/hasard.js';
import { CUISINES } from '../data/cuisines.js';
import { CUISINES_HASARD } from '../data/hasard.js';
import { lien } from '../lib/recettes.js';

const nomCuisine = Object.fromEntries([...CUISINES, ...CUISINES_HASARD].map((c) => [c.slug, c.nom]));
const healthy = VIDEOS.filter((v) => v.healthy);
const groupes = [...CUISINES, ...CUISINES_HASARD]
  .map((c) => ({ ...c, videos: healthy.filter((v) => v.cuisine === c.slug) }))
  .filter((g) => g.videos.length);
---

<Base titre="Healthy" description="Des plats sains qui ont vraiment du goût, quitte à y passer du temps." page="healthy">
  <section class="tete-page seyes">
    <div class="conteneur">
      <div class="dans-la-marge">
        <h1>Healthy</h1>
        <p class="chapeau">
          Sain, mais d’abord savoureux. Des plats qui demandent parfois de s’y mettre (une marinade de trois jours, un
          bouillon de six heures), mais qui valent chaque minute. Pas encore de recettes écrites : chaque plat renvoie à
          sa vidéo de référence.
        </p>
        <a class="bouton-de petit" href={lien('hasard/?healthy')}><span aria-hidden="true">🎲</span> Une idée healthy au hasard ({healthy.length} vidéos)</a>
      </div>
    </div>
  </section>

  <div class="conteneur healthy">
    <h2>Le top 5</h2>
    <ol class="healthy-top">
      {TOP5.map((p) => (
        <li class="healthy-carte">
          <p class="hasard-chaine">{nomCuisine[p.cuisine]} · {p.chef}</p>
          <h3><a href={p.url} target="_blank" rel="noopener">{p.titre}</a></h3>
          <p>{p.pourquoi}</p>
          <p><strong>Pourquoi c’est sain.</strong> {p.sain}</p>
          <p><strong>L’effort.</strong> {p.effort}</p>
        </li>
      ))}
    </ol>

    <h2>Toutes les idées healthy</h2>
    <div class="idees">
      {groupes.map((g) => (
        <section>
          <h2>{g.nom}</h2>
          <ul>
            {g.videos.map((v) => (
              <li>
                <span class="titre-idee"><a href={v.url} target="_blank" rel="noopener">{v.titre}</a></span>
                <p class="note-idee">{v.chaine}{v.recette && <> · <a href={lien(`recette/${v.recette}/`)}>au carnet</a></>}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Base>
