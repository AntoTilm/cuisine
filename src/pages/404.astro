    <div class="conteneur">
      <div class="dans-la-marge">
        <h1>Page introuvable</h1>
        <p class="chapeau">
          Cette page n’existe pas ou a changé d’adresse. <a href={lien()}>Revenir au sommaire</a>
        </p>
      </div>
    </div>
  </section>
</Base>
