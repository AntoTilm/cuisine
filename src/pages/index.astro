---
import Base from '../layouts/Base.astro';
import ListeRecettes from '../components/ListeRecettes.astro';
import { recettesListees, parCuisine, lien } from '../lib/recettes.js';
import { TYPES } from '../data/cuisines.js';

const recettes = await recettesListees();
const cuisines = parCuisine(recettes);
const typesPresents = Object.entries(TYPES).filter(([t]) => recettes.some((r) => r.data.type === t));
---

<Base titre="Carnet de cuisine" page="recettes">
  <section class="une seyes">
    <div class="conteneur">
      <div class="dans-la-marge">
        <h1>Carnet de cuisine</h1>
        <p class="chapeau">
          {recettes.length} recettes rangées par cuisine. Chacune existe en version simple et en version grande cuisine,
          avec sa liste de courses.
        </p>
        <div class="recherche">
          <label for="recherche">Chercher une recette ou un ingrédient</label>
          <input id="recherche" type="search" placeholder="poulet, citron, fondue…" autocomplete="off" />
        </div>
      </div>
    </div>
  </section>

  <div class="conteneur">
    <nav class="sommaire" aria-labelledby="titre-sommaire">
      <h2 id="titre-sommaire">Sommaire</h2>
      <a class="bouton-de petit" href={lien('hasard/')}><span aria-hidden="true">🎲</span> Pas d’idée ? Une recette au hasard</a>
      <ol>
        {
          cuisines.map((c) => (
            <li>
              <a href={lien(`cuisine/${c.slug}/`)}>
                <span class="cuisine-nom">{c.nom}</span>
                <span class="pointilles" aria-hidden="true" />
                <span class="nombre">
                  {c.recettes.length} recette{c.recettes.length > 1 ? 's' : ''}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="filtres" role="group" aria-label="Filtrer par type de plat">
      <span class="legende">Afficher</span>
      <button class="puce" type="button" data-filtre="" aria-pressed="true">Tout</button>
      {
        typesPresents.map(([t, nom]) => (
          <button class="puce" type="button" data-filtre={t} aria-pressed="false">
            {nom === 'Entrée' ? 'Entrées' : nom === 'Plat' ? 'Plats' : `${nom}s`}
          </button>
        ))
      }
    </div>

    {
      cuisines.map((c) => (
        <section class="section-cuisine" id={c.slug} data-section-cuisine>
          <header>
            <h2>
              <a href={lien(`cuisine/${c.slug}/`)} style="color: inherit; text-decoration: none">
                {c.titre}
              </a>
            </h2>
            <p>{c.intro}</p>
          </header>
          <ListeRecettes recettes={c.recettes} />
        </section>
      ))
    }

    <p class="aucun-resultat" id="aucun-resultat" hidden>
      Aucune recette ne correspond. Essayer un autre mot, ou jeter un œil aux <a href={lien('idees/')}>idées à tester</a>.
    </p>
  </div>
</Base>

<script>
  const champ = document.getElementById('recherche') as HTMLInputElement;
  const puces = document.querySelectorAll<HTMLButtonElement>('[data-filtre]');
  const sections = document.querySelectorAll<HTMLElement>('[data-section-cuisine]');
  const aucun = document.getElementById('aucun-resultat')!;
  let filtre = '';

  const normaliser = (s: string) =>
    s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/œ/g, 'oe').trim();

  function appliquer() {
    const mots = normaliser(champ.value).split(/\s+/).filter(Boolean);
    let total = 0;
    sections.forEach((s) => {
      let visibles = 0;
      s.querySelectorAll<HTMLElement>('.ligne').forEach((l) => {
        const ok = (!filtre || l.dataset.type === filtre) && mots.every((m) => l.dataset.recherche!.includes(m));
        l.hidden = !ok;
        if (ok) visibles++;
      });
      s.hidden = visibles === 0;
      total += visibles;
    });
    aucun.hidden = total > 0;
  }

  champ.addEventListener('input', appliquer);
  puces.forEach((p) =>
    p.addEventListener('click', () => {
      filtre = p.dataset.filtre || '';
      puces.forEach((x) => x.setAttribute('aria-pressed', String(x === p)));
      appliquer();
    }),
  );
  if (champ.value) appliquer();
</script>
